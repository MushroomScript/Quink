{
  "name": "@quink/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Quink (一念) desktop client - quick capture + AI auto-organize for personal notes",
  "homepage": "https://github.com/MushroomScript/Quink",
  "author": {
    "name": "Mushroom",
    "email": "mushroom@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron . --remote-debugging-port=9222",
    "build": "tsc",
    "watch": "tsc -w",
    "build:runtime": "pnpm --filter @quink/server build && pnpm --filter @quink/server build:bundle && pnpm --filter @quink/web build && node scripts/prepare-server-runtime.mjs",
    "pack": "tsc && pnpm run build:runtime && electron-builder --dir",
    "dist": "tsc && pnpm run build:runtime && electron-builder",
    "dist:win": "tsc && pnpm run build:runtime && node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\" && electron-builder --win",
    "dist:mac": "tsc && pnpm run build:runtime && electron-builder --mac",
    "dist:linux": "tsc && pnpm run build:runtime && electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "cc.quink.desktop",
    "productName": "Quink",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": ["**/*.node", "build/icon-*.ico", "build/trayTemplate*.png"],
    "electronVersion": "35.0.0",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "build/icon-*.ico",
      "build/trayTemplate*.png",
      "package.json"
    ],
    "extraResources": [
      { "from": "server-runtime", "to": "server" }
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Quink"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "publish": null
  }
}
