{
  "name": "@quink/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsc",
    "build:bundle": "esbuild dist/index.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist-bundle/index.cjs --external:better-sqlite3 --external:sharp --external:@img/* --external:libheif-js",
    "build:binary": "pnpm run build && pnpm run build:bundle && pkg . --targets node22-win-x64 --output dist-binary/quink-server.exe",
    "dist:binary": "pnpm --filter @quink/web build && node scripts/copy-web-dist.mjs && pnpm run build:binary",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "bin": "dist-bundle/index.cjs",
  "pkg": {
    "scripts": [
      "dist-bundle/**/*.cjs"
    ],
    "assets": [
      "../../node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "../../node_modules/better-sqlite3/lib/**/*",
      "../../node_modules/better-sqlite3/package.json",
      "../../node_modules/sharp/**/*",
      "../../node_modules/@img/**/*",
      "../../node_modules/libheif-js/**/*",
      "../../node_modules/quink-web-dist/**/*",
      "package.json"
    ],
    "outputPath": "dist-binary",
    "targets": [
      "node22-win-x64",
      "node22-macos-arm64",
      "node22-linux-x64"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.0",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "libheif-js": "^1.19.8",
    "nanoid": "^5.1.0",
    "nodemailer": "^8.0.10",
    "pinyin-pro": "^3.28.1",
    "rrule": "^2.8.1",
    "sharp": "^0.34.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.0",
    "@yao-pkg/pkg": "^6.4.0",
    "drizzle-kit": "^0.30.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
