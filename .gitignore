node_modules/
dist/
dist-bundle/
dist-binary/
/web-dist/
dist-electron/
.env
.env.local
*.db
*.db-shm
*.db-wal
*.sqlite
.DS_Store
Thumbs.db
pnpm-lock.yaml

# Vditor static files (copied from node_modules, regenerated on install)
packages/web/public/vditor/

# Electron build output
packages/desktop/dist/

# 桌面内嵌 server 打包产物 (prepare-server-runtime.mjs 生成: bundle + native node_modules + web-dist, 不入库)
packages/desktop/server-runtime/

# TypeScript incremental build cache (vue-tsc -b / tsc --incremental 生成)
*.tsbuildinfo

# vue-tsc -b 编译产物 (web 源是 .vue/.ts, build 模式 emit 的 .js/.d.ts/.map 不入库)
packages/web/src/**/*.js
packages/web/src/**/*.js.map
packages/web/src/**/*.d.ts
packages/web/src/**/*.d.ts.map

# Rust build output
packages/native/target/
packages/native/*.node

# Uploads
packages/server/uploads/

# Docker 用户数据目录 (docker-compose volume 挂载点, 含 quink.db + uploads + 缩略图)
quink-data/

# IDE
.vscode/
.idea/

# OS
*.log

# Playwright MCP 调试残留(snapshot / console log / 截图)
.playwright-mcp/
blinko-analytics.png

# DB 备份(手动备份不入库)
*.db.bak-*

# 所有 md 文档不 git (README.md 例外, 后期上传)
*.md
!README.md

# bat 启动脚本不 git (个人开发环境用)
*.bat

# Claude Code 本地配置 + 项目级 skill (本地开发用, 不影响项目运行)
.claude/

# 调试 / 测试用静态文件 (不影响项目启动)
badge-test.html
packages/desktop/test-keys.js
login-demo-*.html

# 辅助脚本 (seed 测试数据 / 构建图标等, 个人开发环境用)
scripts/
# 例外: 桌面打包必需脚本要入库. scripts/ 已忽略整个目录, 父目录被 ignore 时子文件的 ! 例外不生效,
# 必须先放行目录、再忽略目录内容、最后放行具体文件
!packages/desktop/scripts/
packages/desktop/scripts/*
!packages/desktop/scripts/prepare-server-runtime.mjs
!packages/server/scripts/
packages/server/scripts/*
!packages/server/scripts/copy-web-dist.mjs

# 临时调试截图 (MCP 截图给蘑菇看 / 视觉对比, 用完删 + 同步移除此规则)
.tmp-*.png
